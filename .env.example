# Contact form (app/api/contact). Copy to .env.local and fill in. Never commit real keys.
#
# Resend (https://resend.com): create an API key and put it here.
# For local testing without sending anything, set RESEND_API_KEY=dry-run and the
# message is printed to the server console instead.
RESEND_API_KEY=
# Where messages are delivered (your inbox).
CONTACT_TO=you@email.com
# The From address. Until you verify a domain in Resend, use their test sender below
# (it only delivers to the email address your Resend account was created with).
CONTACT_FROM=NICK.ODE <onboarding@resend.dev>
